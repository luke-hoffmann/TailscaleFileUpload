<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Taildrop</AssemblyName>
    <RootNamespace>TaildropApp</RootNamespace>
    <!-- Explorer / desktop icon. Made by tools/e2e/make-app-icon.mjs; also embedded below for the window and taskbar. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Single portable exe: self-contained .NET runtime, no separate install on the target machine -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets a WinForms (non-Web SDK) project use Kestrel/ASP.NET Core hosting APIs -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taildrop.Core\Taildrop.Core.csproj" />
    <EmbeddedResource Include="app.ico" LogicalName="TaildropApp.app.ico" />
    <!-- Native OpenCV for the document scanner (Windows x64). -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

  <!--
    The OpenCV runtime package ships a large opencv_videoio_ffmpeg*.dll (video file/stream I/O) that document
    scanning never uses. Keep it out of the published single file and out of the build output.
  -->
  <Target Name="DropUnusedOpenCvFfmpegFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_UnusedOpenCvFfmpegPublish Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <ResolvedFileToPublish Remove="@(_UnusedOpenCvFfmpegPublish)" />
    </ItemGroup>
  </Target>

  <Target Name="DropUnusedOpenCvFfmpegFromOutput" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <_UnusedOpenCvFfmpegCopy Include="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('opencv_videoio_ffmpeg'))" />
      <ReferenceCopyLocalPaths Remove="@(_UnusedOpenCvFfmpegCopy)" />
    </ItemGroup>
  </Target>

</Project>
